NEXT_PUBLIC_FE_URL=http://localhost:3000
NEXT_PUBLIC_BE_URL=http://localhost:3001

# Production: set NEXT_PUBLIC_BE_URL to the deployed API origin.
# Backend FRONTEND_URL must match this front-office origin (CORS).

# Supabase Storage — opsional. Tanpa ini, upload file dimatikan dan dokumen
# diisi dengan menempel link manual. Bucket harus PRIVATE (lihat README).
# SUPABASE_SERVICE_ROLE_KEY hanya untuk server, jangan diberi prefix NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=dokumen
