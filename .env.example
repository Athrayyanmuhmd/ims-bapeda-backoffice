# Local
NEXT_PUBLIC_FE_URL=http://localhost:3000
NEXT_PUBLIC_BE_URL=http://localhost:3001

# Production (Vercel → simagang-bapeda → Environment Variables)
# NEXT_PUBLIC_FE_URL=https://simagang-bapeda.vercel.app
# NEXT_PUBLIC_BE_URL=https://simagang-bapeda-api.vercel.app

# Backend FRONTEND_URL must match NEXT_PUBLIC_FE_URL (CORS).

# Supabase Storage — opsional. Hanya untuk upload dokumen (bukan Auth).
# Jangan install @supabase/ssr untuk login: auth SIMAGANG tetap JWT API sendiri.
# Bucket harus PRIVATE. SUPABASE_SERVICE_ROLE_KEY hanya di server (tanpa NEXT_PUBLIC_).
#
# SUPABASE_URL=https://brgyaorhucichpxtswtb.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   # service_role dari Project Settings → API
# SUPABASE_BUCKET=dokumen
#
# JANGAN pakai NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY untuk auth di project ini.
